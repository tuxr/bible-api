{
  "name": "bible-api",
  "version": "1.0.0",
  "description": "Self-hosted Bible API on Cloudflare Workers with D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "data:download": "tsx data/scripts/download-sources.ts",
    "data:parse": "tsx data/scripts/parse-usfx.ts",
    "data:validate": "tsx data/scripts/validate.ts",
    "db:schema:local": "wrangler d1 execute bible-db --local --file=./schemas/schema.sql",
    "db:schema": "wrangler d1 execute bible-db --file=./schemas/schema.sql",
    "db:seed": "tsx data/scripts/seed-d1.ts"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.8",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/sax": "^1.2.7",
    "sax": "^1.4.1",
    "unzipper": "^0.12.0",
    "@types/unzipper": "^0.10.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.61.1"
  }
}
